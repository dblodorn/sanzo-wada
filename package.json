{
  "name": "sanzo-wada",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:alpha": "turbo run dev --filter=sanzo-wada-alpha",
    "build:alpha": "turbo run build --filter=sanzo-wada-alpha",
    "dev:beta": "turbo run dev --filter=sanzo-wada-beta",
    "build:beta": "turbo run build --filter=sanzo-wada-beta",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "author": "Dain Blodorn Kim",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.5.0",
    "husky": "^9.0.11",
    "prettier": "^3.3.2",
    "turbo": "^2.0.5"
  },
  "packageManager": "pnpm@8.15.3",
  "lint-staged": {
    "apps/**/*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ],
    "packages/**/*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "tsc-files --noEmit"
    ]
  }
}
